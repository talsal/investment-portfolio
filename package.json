{
  "name": "investment-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hebrew RTL personal-wealth dashboard (static, GitHub Pages)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:golden": "playwright test tests/golden",
    "golden:update": "UPDATE_GOLDEN=1 playwright test tests/golden",
    "golden:private": "GOLDEN_PRIVATE=1 playwright test tests/golden --grep @private",
    "fixtures": "node scripts/make-fixtures.mjs",
    "engine:sanitize": "node scripts/sanitize-engine.mjs",
    "check:private": "node scripts/guard-personal-data.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "parity:private": "GOLDEN_PRIVATE=1 playwright test tests/e2e --grep @private",
    "test:e2e": "playwright test tests/e2e",
    "test:all": "vitest run && playwright test",
    "data:market": "tsx scripts/data/refresh-market.ts",
    "data:fundamentals": "tsx scripts/data/refresh-fundamentals.ts",
    "data:validate": "tsx scripts/data/validate-data.ts",
    "data:probe": "tsx scripts/data/probe.ts",
    "data:reindex": "tsx -e \"import('./scripts/data/reindex.ts').then(m=>console.log(m.reindex(process.env.DATA_DIR??'data')?'market.json updated':'no change'))\"",
    "analysis:generate": "tsx scripts/analysis/generate.ts",
    "analysis:dry-run": "tsx scripts/analysis/generate.ts --dry-run",
    "analysis:approve": "tsx scripts/analysis/approve.ts",
    "analysis:prompt": "tsx scripts/analysis/manual-flow.ts prompt",
    "analysis:import": "tsx scripts/analysis/manual-flow.ts import",
    "audit:publication": "node scripts/audit-publication.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0"
  }
}
