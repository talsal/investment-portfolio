{
  "version": 1,
  "_comment": "Calculation rules extracted verbatim from the reference engine. Do not change a value without flagging it.",
  "fx": {
    "defaultUsdIls": 3.11
  },
  "criteria": {
    "pe": {
      "maxForward": 11,
      "requiresReliableEarnings": true
    },
    "fcf": {
      "minYieldPct": 8,
      "minTrendPctPerYear": -10,
      "roeMinPct": 15
    },
    "moat": {
      "passesOn": "ok"
    },
    "growth": {
      "passesOn": "up"
    },
    "scoreOutOf": 4
  },
  "hold": {
    "redFlags": {
      "moat": [
        "bad"
      ],
      "growth": [
        "neg"
      ],
      "fcfTrendBelowPct": 0
    },
    "yellowFlags": {
      "moat": [
        "weak",
        "contested"
      ],
      "growth": [
        "slow",
        "flat"
      ]
    },
    "reconsiderAtRedCount": 2
  },
  "add": {
    "requires": {
      "pe": true,
      "fcf": true,
      "moat": "ok",
      "growthNot": "neg"
    }
  },
  "annualization": {
    "minHoldingDays": 30,
    "daysPerYear": 365,
    "method": "linear"
  },
  "dividends": {
    "netTaxApprox": 0.25,
    "defaultPaymentsPerYear": 4
  },
  "cashflow": {
    "cushionMonthsOptions": [
      3,
      6,
      9,
      12
    ],
    "defaultCushionMonths": 6
  },
  "limits": {
    "rows": 60,
    "funds": 20,
    "trades": 400,
    "watchlist": 30
  },
  "currency": {
    "agorotFactor": 0.01
  },
  "withdrawal": {
    "timing": "end-of-month",
    "maxYears": 60,
    "formula": "W = B*i / (1-(1+i)^-n), i = (1+realAnnual)^(1/12)-1, n = years*12; i=0 -> B/n",
    "_note": "Spec chosen by the assistant (default of plan decision 3); confirm with owner."
  },
  "backup": {
    "nudgeDays": 14,
    "maxFileBytes": 524288,
    "snoozeDays": 3
  },
  "freshness": {
    "_comment": "Calendar days after which a data group is shown as stale.",
    "staleAfterDays": {
      "fx": 4,
      "quotes": 4,
      "benchmark": 4,
      "calendar": 10,
      "cpi": 50,
      "fundamentals": 120,
      "history": 7
    }
  },
  "history": {
    "years": 5
  }
}
